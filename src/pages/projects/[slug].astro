---
import Layout from '../../layouts/Layout.astro';
import DownloadVersion from '../../components/DownloadVersion.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const isFPL = project.data.license === 'FPL';
const licenseLabel = isFPL ? 'Source-available' : 'Commercial';
const licenseClass = isFPL
  ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400'
  : 'bg-amber-500/10 border-amber-500/30 text-amber-400';

const versions = project.data.downloads ?? [];
const latestVersionId = project.data.latestVersion;
const latest = versions.find((v) => v.version === latestVersionId);
const older = versions.filter((v) => v.version !== latestVersionId);
const hasOlder = older.length > 0;
---

<Layout
  title={`${project.data.title} — FomaDev`}
  description={project.data.description}
>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <a href="/" class="text-sm text-zinc-500 hover:text-zinc-300">← All projects</a>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <h1 class="text-4xl font-bold tracking-tight">{project.data.title}</h1>
      <span class="rounded bg-zinc-800 px-2 py-1 text-xs text-zinc-300">
        {project.data.language}
      </span>
      <span class={`rounded border px-2 py-1 text-xs ${licenseClass}`}>
        {licenseLabel}
      </span>
    </div>

    <p class="mt-4 text-lg text-zinc-400">{project.data.description}</p>

    {project.data.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {project.data.tags.map((t) => (
          <li class="rounded-full border border-zinc-800 px-3 py-1 text-xs text-zinc-400">
            {t}
          </li>
        ))}
      </ul>
    )}

    {project.data.image && (
      <figure class="mt-8">
        <img
          src={project.data.image.src}
          alt={project.data.image.alt}
          loading="lazy"
          class="w-full rounded-xl border border-zinc-800 bg-zinc-900"
        />
      </figure>
    )}

    <div class="mt-10 flex flex-wrap gap-3">
      {project.data.githubUrl && (
        <a
          href={project.data.githubUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-lg bg-emerald-500 px-5 py-2.5 text-sm font-medium text-zinc-950 hover:bg-emerald-400 transition-colors"
        >
          View on GitHub ↗
        </a>
      )}
    </div>

    {/* Section Latest : reste ici, juste après le bouton GitHub */}
    {versions.length > 0 && (
      <div class="mt-12">
        <h2 class="text-sm font-medium uppercase tracking-wider text-zinc-500">
          Download
        </h2>

        {latest ? (
          <div class="mt-4">
            <DownloadVersion
              version={latest.version}
              date={latest.date}
              files={latest.files}
              isLatest={true}
            />
          </div>
        ) : (
          <p class="mt-3 text-sm text-zinc-500">
            No latest version is marked for this project.
          </p>
        )}

        {hasOlder && (
          <a
            href="#all-versions"
            class="mt-4 inline-flex items-center gap-1.5 text-sm text-zinc-500 hover:text-emerald-400 transition-colors"
          >
            See all versions ({versions.length}) <span>↓</span>
          </a>
        )}
      </div>
    )}

    {/* Contenu Markdown du projet */}
    <div class="prose prose-invert prose-emerald mt-12 max-w-none">
      <Content />
    </div>

    {/* Section "All versions" : tout en bas de la page */}
    {hasOlder && (
      <section
        id="all-versions"
        class="mt-20 pt-10 border-t border-zinc-800"
      >
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-medium uppercase tracking-wider text-zinc-500">
            All versions
          </h2>
          <a
            href="#top"
            class="text-xs text-zinc-600 hover:text-zinc-300 transition-colors"
          >
            ↑ Back to top
          </a>
        </div>

        <div class="mt-4 space-y-3">
          {older.map((v) => (
            <DownloadVersion
              version={v.version}
              date={v.date}
              files={v.files}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>