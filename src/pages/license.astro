---
import Layout from '../layouts/Layout.astro';
import ArrowLeft from '../components/icons/ArrowLeft.astro';
import ArrowUpRight from '../components/icons/ArrowUpRight.astro';
import ShieldIcon from '../components/icons/ShieldIcon.astro';
import CheckIcon from '../components/icons/CheckIcon.astro';
import FomaLogo from '../components/icons/FomaLogo.astro';
---

<Layout
  title="Licensing — FomaDev"
  description="FomaDev projects are released under one of two licenses: the Fordima Public License (FPL) or the Fordima Commercial License (FCL)."
  activePath="/license"
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <!-- Breadcrumb -->
    <nav class="mb-8 pb-4 border-b border-white/[0.07]">
      <a
        href="/#projects"
        class="group inline-flex items-center gap-1.5 text-xs text-zinc-400 hover:text-white transition-colors font-medium"
      >
        <ArrowLeft class="w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform" />
        <span>Return to projects</span>
      </a>
    </nav>

    <!-- Header Section -->
    <header class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded text-xs font-mono font-medium bg-blue-500/10 text-blue-400 border border-blue-500/25">
        <ShieldIcon class="w-3.5 h-3.5" />
        <span>Fordima Licensing Framework</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-tight">
        Licensing in the Fordima Ecosystem
      </h1>

      <p class="text-base sm:text-lg text-zinc-300 leading-relaxed font-normal">
        Everything built within the Fordima ecosystem is released under one of two licenses. They share one core philosophy: <strong class="text-white font-medium">people should be free to use our software, and the work behind it should stay protected.</strong>
      </p>

      <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
        Fordima Inc. is the parent company. Its subsidiaries, such as FomaDev, build and publish the software. The licenses belong to Fordima, ensuring every project follows the exact same clear rules.
      </p>
    </header>

    <!-- Side-by-Side Dual License Overview -->
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <!-- FPL Card -->
      <div class="rounded-xl border border-emerald-500/30 bg-[#0c1214] p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-mono font-semibold bg-emerald-500/15 border border-emerald-500/30 text-emerald-400">
              <ShieldIcon class="w-3 h-3" />
              FPL
            </span>
            <span class="text-xs font-mono text-zinc-400">Source-available</span>
          </div>

          <h3 class="mt-4 text-lg font-bold text-white">Fordima Public License</h3>
          <p class="mt-1.5 text-xs sm:text-sm text-zinc-400 leading-relaxed">
            Our license for open, collaborative software. Used by the majority of our tools, engines, and libraries.
          </p>

          <ul class="mt-5 space-y-2.5 text-xs sm:text-sm text-zinc-300">
            <li class="flex items-start gap-2">
              <span class="p-0.5 rounded bg-emerald-500/20 text-emerald-400 shrink-0 mt-0.5">
                <CheckIcon class="w-3 h-3" />
              </span>
              <span><strong>Free for commercial use:</strong> No fee, royalty, or registration required.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="p-0.5 rounded bg-emerald-500/20 text-emerald-400 shrink-0 mt-0.5">
                <CheckIcon class="w-3 h-3" />
              </span>
              <span><strong>Open contributions:</strong> Fork, inspect, and submit pull requests anytime.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="p-0.5 rounded bg-emerald-500/20 text-emerald-400 shrink-0 mt-0.5">
                <CheckIcon class="w-3 h-3" />
              </span>
              <span><strong>Freedom to integrate:</strong> Freely build parts of the code into internal tools.</span>
            </li>
            <li class="flex items-start gap-2 text-zinc-400">
              <span class="p-0.5 rounded bg-zinc-800 text-zinc-400 shrink-0 mt-0.5">
                <ShieldIcon class="w-3 h-3" />
              </span>
              <span><strong>Protected from direct resale:</strong> Paid license required to resell the code or run a competing cloud SaaS.</span>
            </li>
          </ul>
        </div>

        <div class="mt-6 pt-4 border-t border-emerald-500/20">
          <a
            href="#fpl"
            class="inline-flex items-center gap-1 text-xs font-medium text-emerald-400 hover:text-emerald-300 transition-colors"
          >
            <span>Read full FPL terms</span>
            <span>↓</span>
          </a>
        </div>
      </div>

      <!-- FCL Card -->
      <div class="rounded-xl border border-amber-500/30 bg-[#14120e] p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-mono font-semibold bg-amber-500/15 border border-amber-500/30 text-amber-400">
              <ShieldIcon class="w-3 h-3" />
              FCL
            </span>
            <span class="text-xs font-mono text-zinc-400">Commercial Software</span>
          </div>

          <h3 class="mt-4 text-lg font-bold text-white">Fordima Commercial License</h3>
          <p class="mt-1.5 text-xs sm:text-sm text-zinc-400 leading-relaxed">
            Our license for paid commercial editions and desktop graphical tools like Kiva Studio Pro.
          </p>

          <ul class="mt-5 space-y-2.5 text-xs sm:text-sm text-zinc-300">
            <li class="flex items-start gap-2">
              <span class="p-0.5 rounded bg-amber-500/20 text-amber-400 shrink-0 mt-0.5">
                <CheckIcon class="w-3 h-3" />
              </span>
              <span><strong>Free evaluation:</strong> Install, test locally, and evaluate in staging without fees.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="p-0.5 rounded bg-amber-500/20 text-amber-400 shrink-0 mt-0.5">
                <CheckIcon class="w-3 h-3" />
              </span>
              <span><strong>Production deployment:</strong> Deploy on client servers and commercial infrastructure.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="p-0.5 rounded bg-amber-500/20 text-amber-400 shrink-0 mt-0.5">
                <CheckIcon class="w-3 h-3" />
              </span>
              <span><strong>Professional support:</strong> Guaranteed updates and dedicated vendor assistance.</span>
            </li>
            <li class="flex items-start gap-2 text-zinc-400">
              <span class="p-0.5 rounded bg-zinc-800 text-zinc-400 shrink-0 mt-0.5">
                <ShieldIcon class="w-3 h-3" />
              </span>
              <span><strong>Funds open ecosystem:</strong> Commercial editions finance maintainers of free FPL tools.</span>
            </li>
          </ul>
        </div>

        <div class="mt-6 pt-4 border-t border-amber-500/20">
          <a
            href="#fcl"
            class="inline-flex items-center gap-1 text-xs font-medium text-amber-400 hover:text-amber-300 transition-colors"
          >
            <span>Read full FCL terms</span>
            <span>↓</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Comparison Matrix -->
    <div class="mt-12 rounded-xl border border-white/[0.08] bg-[#0c0e14] p-6 sm:p-8">
      <h3 class="text-base sm:text-lg font-bold text-white mb-2">How the two work together</h3>
      <p class="text-xs sm:text-sm text-zinc-400 mb-6">
        A single product can use both: an FPL core that everyone can use and improve, and an FCL edition with advanced features for businesses that need them.
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm border-separate border-spacing-0">
          <thead>
            <tr class="border-b border-zinc-800">
              <th class="py-3 px-4 font-semibold text-zinc-400 border-b border-zinc-800 font-mono text-xs">Dimension</th>
              <th class="py-3 px-4 font-semibold text-emerald-400 border-b border-zinc-800 font-mono text-xs">FPL (Open / Core)</th>
              <th class="py-3 px-4 font-semibold text-amber-400 border-b border-zinc-800 font-mono text-xs">FCL (Commercial)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-800/60">
            <tr>
              <td class="py-3 px-4 font-medium text-zinc-200">Purpose</td>
              <td class="py-3 px-4 text-zinc-400">Open, collaborative software</td>
              <td class="py-3 px-4 text-zinc-400">Paid, commercial software</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-zinc-200">Cost</td>
              <td class="py-3 px-4 text-emerald-400 font-medium">Free, including for businesses</td>
              <td class="py-3 px-4 text-amber-400 font-medium">Paid for production use</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-zinc-200">Source code</td>
              <td class="py-3 px-4 text-zinc-400">Public, open to contributions</td>
              <td class="py-3 px-4 text-zinc-400">Available for evaluation only</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-zinc-200">Contributions</td>
              <td class="py-3 px-4 text-zinc-400">Welcome via pull request</td>
              <td class="py-3 px-4 text-zinc-500 font-mono">Not applicable</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-medium text-zinc-200">Competing products</td>
              <td class="py-3 px-4 text-zinc-400">Require a paid license</td>
              <td class="py-3 px-4 text-zinc-500 font-mono">Not permitted</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Full Legal Text Content -->
    <div class="prose prose-invert prose-zinc mt-14 max-w-none border-t border-white/[0.07] pt-10">
      <h2 id="fpl">Fordima Public License (FPL)</h2>

      <p>
        The FPL is our license for open, collaborative software. Most of our
        projects use it.
      </p>

      <p>
        <strong>What it is.</strong> The source code is public and free to use.
        It is <em>source-available</em>: you can read it, learn from it and
        contribute to it, while a few specific uses stay reserved, to protect
        the project.
      </p>

      <p><strong>What it gives you.</strong></p>

      <ul>
        <li>
          <strong>Free use, including in business.</strong> Individuals,
          students and companies can use FPL software at no cost, including in
          commercial products and projects that earn money. No fee, no royalty,
          no registration.
        </li>
        <li>
          <strong>Open contributions.</strong> You can fork a project, improve
          it and send your work back through a pull request. Contributions are
          welcome and make the project better for everyone.
        </li>
        <li>
          <strong>Freedom to integrate.</strong> You can build parts of the
          code into your own systems and tools.
        </li>
      </ul>

      <p>
        <strong>What it reserves.</strong> A paid license is required only when
        the code is used to create a similar or competing product, to keep a
        private copy to build the same thing, to resell the source code, or to
        offer a paid hosted version of it. Permanent forks made to bypass the
        official project are not allowed.
      </p>

      <p>
        <strong>Why it matters.</strong> It keeps our tools accessible to
        everyone, from a student learning in Kinshasa to a large company
        shipping a product, while making sure that the people who build and
        maintain a project are not simply copied and replaced by a competitor
        using their own code. That protection is what lets us keep publishing,
        improving and supporting open software.
      </p>

      <hr />

      <h2 id="fcl">Fordima Commercial License (FCL)</h2>

      <p>
        The FCL is our license for paid software. It covers the commercial
        editions of our products, such as Pro and Cloud versions.
      </p>

      <p>
        <strong>What it is.</strong> The source may be available for
        evaluation, but the software is not open source. You buy the right to
        <em>use</em> it; you do not buy the code itself.
      </p>

      <p><strong>What it gives you.</strong></p>

      <ul>
        <li>
          <strong>Free evaluation.</strong> You can install and test the
          software locally or in staging, without paying and without a license
          key, to check that it fits your needs.
        </li>
        <li>
          <strong>Production rights.</strong> A paid license lets you run the
          software in production: in a deployed website, a live API or a
          service for your own clients, according to the plan you chose.
        </li>
        <li>
          <strong>Professional support and updates</strong> for the duration of
          your plan.
        </li>
      </ul>

      <p>
        <strong>What it reserves.</strong> The software cannot be resold,
        redistributed, sublicensed or used to build a competing product.
        License keys cannot be shared.
      </p>

      <p>
        <strong>Why it matters.</strong> Paid products fund the full ecosystem:
        the commercial editions pay for the time spent on the free ones. They
        also give businesses a clear contract, with defined rights, support and
        responsibilities, and that is what they need to rely on software in
        production.
      </p>
    </div>

    <!-- Commercial License Contact Card -->
    <div class="mt-14 rounded-xl border border-white/[0.08] bg-[#0c0e14] p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/20 p-2 flex items-center justify-center shrink-0">
          <FomaLogo class="w-full h-full text-blue-500" gradient={true} />
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Commercial Agreements & Custom Licensing</h3>
          <p class="text-xs sm:text-sm text-zinc-400 mt-1 max-w-xl leading-relaxed">
            To obtain an enterprise commercial agreement, discuss SLA support plans, or request custom licensing terms, contact the management team at Fordima Inc.
          </p>
        </div>
      </div>
      <a
        href="https://github.com/fomadev"
        target="_blank"
        rel="noopener"
        class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-zinc-100 text-zinc-950 hover:bg-white text-xs sm:text-sm font-semibold transition-all shadow-sm"
      >
        <span>Contact Fordima Inc.</span>
        <ArrowUpRight class="w-3.5 h-3.5" />
      </a>
    </div>
  </article>
</Layout>
