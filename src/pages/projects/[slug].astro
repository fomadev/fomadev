---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} — FomaDev`}
  description={project.data.description}
>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <a href="/" class="text-sm text-zinc-500 hover:text-zinc-300">← All projects</a>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <h1 class="text-4xl font-bold tracking-tight">{project.data.title}</h1>
      <span class="rounded bg-zinc-800 px-2 py-1 text-xs text-zinc-300">
        {project.data.language}
      </span>
    </div>

    <p class="mt-4 text-lg text-zinc-400">{project.data.description}</p>

    {project.data.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {project.data.tags.map((t) => (
          <li class="rounded-full border border-zinc-800 px-3 py-1 text-xs text-zinc-400">
            {t}
          </li>
        ))}
      </ul>
    )}

    <div class="mt-8">
      <a
        href={project.data.githubUrl}
        target="_blank"
        rel="noopener"
        class="inline-block rounded-lg bg-emerald-500 px-5 py-2.5 text-sm font-medium text-zinc-950 hover:bg-emerald-400 transition-colors"
      >
        View on GitHub ↗
      </a>
    </div>

    <div class="prose prose-invert prose-emerald mt-12 max-w-none">
      <Content />
    </div>
  </article>
</Layout>