---
import OsIcon from './icons/OsIcon.astro';
import DownloadIcon from './icons/DownloadIcon.astro';
import CalendarIcon from './icons/CalendarIcon.astro';

interface DownloadFile {
  os: 'linux' | 'windows' | 'macos' | 'universal';
  label: string;
  url: string;
}

interface Props {
  version: string;
  date?: string;
  files: DownloadFile[];
  isLatest?: boolean;
}

const { version, date, files, isLatest = false } = Astro.props;
---

<div
  class={`rounded-xl border p-5 transition-all ${
    isLatest
      ? 'border-blue-500/30 bg-[#0e111a]'
      : 'border-white/[0.07] bg-[#0c0e14] hover:border-zinc-700'
  }`}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <span class="font-mono text-sm sm:text-base font-semibold text-white">
        v{version}
      </span>
      {isLatest && (
        <span class="inline-flex items-center gap-1 rounded px-2 py-0.5 text-[10px] font-mono font-medium tracking-wide bg-blue-500/15 border border-blue-500/30 text-blue-400">
          Latest Release
        </span>
      )}
    </div>

    {date && (
      <span class="inline-flex items-center gap-1.5 text-xs text-zinc-500 font-mono">
        <CalendarIcon class="w-3.5 h-3.5 text-zinc-500" />
        {date}
      </span>
    )}
  </div>

  <div class="mt-4 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
    {files.map((file) => (
      <a
        href={file.url}
        target="_blank"
        rel="noopener"
        class={`group flex items-center justify-between gap-3 rounded-lg border px-3.5 py-2.5 text-xs font-medium transition-all ${
          isLatest
            ? 'border-white/[0.08] bg-zinc-900/90 hover:border-blue-500/50 hover:bg-zinc-850 text-zinc-200 hover:text-white'
            : 'border-zinc-800 bg-zinc-950/80 hover:border-zinc-700 hover:bg-zinc-900 text-zinc-300 hover:text-white'
        }`}
      >
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="p-1 rounded bg-zinc-800/80 border border-zinc-700/60 text-zinc-300 group-hover:text-blue-400 transition-colors">
            <OsIcon os={file.os} class="w-3.5 h-3.5" />
          </span>
          <span class="truncate font-sans">{file.label}</span>
        </div>
        <DownloadIcon class="w-3.5 h-3.5 shrink-0 text-zinc-500 group-hover:text-blue-400 group-hover:translate-y-0.5 transition-all" />
      </a>
    ))}
  </div>
</div>
