---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FomaDev — Open source projects</title>
  </head>
  <body class="bg-zinc-950 text-zinc-100 font-sans">
    <main class="max-w-5xl mx-auto px-6 py-20">
      <h1 class="text-4xl font-bold tracking-tight">FomaDev</h1>
      <p class="mt-3 text-zinc-400">
        Open-source tools for performance-minded developers.
      </p>

      <ul class="mt-12 grid gap-6 sm:grid-cols-2">
        {projects.map((p) => (
          <li class="rounded-xl border border-zinc-800 bg-zinc-900 p-6">
            <h2 class="text-xl font-semibold">{p.data.title}</h2>
            <p class="mt-2 text-sm text-zinc-400">{p.data.description}</p>
            <div class="mt-4 flex items-center justify-between text-xs">
              <span class="rounded bg-zinc-800 px-2 py-1 text-zinc-300">
                {p.data.language}
              </span>
              <a
                href={p.data.githubUrl}
                class="text-emerald-400 hover:text-emerald-300"
                target="_blank"
                rel="noopener"
              >
                View on GitHub →
              </a>
            </div>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>