---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout>
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-12">
    <h1 class="text-5xl font-bold tracking-tight">FomaDev</h1>
    <p class="mt-4 text-lg text-zinc-400 max-w-2xl">
      Performance-minded software built in C, Rust, and TypeScript. Most projects are
      <a href="/license" class="text-emerald-400 hover:text-emerald-300 underline underline-offset-4">source-available</a>
      under the FomaDev Public License; a few are commercial under the
      <a href="/license" class="text-amber-400 hover:text-amber-300 underline underline-offset-4">Fordima Commercial License</a>.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-8">
    <ul class="grid gap-6 sm:grid-cols-2">
      {projects.map((p) => {
        const isFPL = p.data.license === 'FPL';
        const badgeClass = isFPL
          ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400'
          : 'bg-amber-500/10 border-amber-500/30 text-amber-400';
        return (
          <li>
            <a
              href={`/projects/${p.id}/`}
              class="group block h-full rounded-xl border border-zinc-800 bg-zinc-900 p-6 hover:border-emerald-500/50 transition-colors"
            >
              <div class="flex items-start justify-between gap-4">
                <h2 class="text-xl font-semibold group-hover:text-emerald-400 transition-colors">
                  {p.data.title}
                </h2>
                <div class="shrink-0 flex flex-wrap gap-1.5">
                  <span class="rounded bg-zinc-800 px-2 py-1 text-xs text-zinc-300">
                    {p.data.language}
                  </span>
                  <span class={`rounded border px-2 py-1 text-xs ${badgeClass}`}>
                    {isFPL ? 'FPL' : 'FCL'}
                  </span>
                </div>
              </div>
              <p class="mt-3 text-sm text-zinc-400">{p.data.description}</p>
              <div class="mt-6 text-xs text-zinc-500 group-hover:text-zinc-300 transition-colors">
                Read more →
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</Layout>