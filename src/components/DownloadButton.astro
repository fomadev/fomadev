---
interface Props {
  os: 'linux' | 'windows' | 'macos';
  label: string;
  url: string;
}

const { os, label, url } = Astro.props;

const icons = {
  linux: '🐧',
  windows: '🪟',
  macos: '🍎',
};
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  class="group inline-flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900 px-4 py-2.5 text-sm text-zinc-200 hover:border-emerald-500/50 hover:text-emerald-400 transition-colors"
>
  <span class="text-base">{icons[os]}</span>
  <span>{label}</span>
  <span class="text-zinc-600 group-hover:text-emerald-400 transition-colors">↓</span>
</a>