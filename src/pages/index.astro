---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ArrowRight from '../components/icons/ArrowRight.astro';
import ArrowDown from '../components/icons/ArrowDown.astro';
import ArrowUpRight from '../components/icons/ArrowUpRight.astro';
import ShieldIcon from '../components/icons/ShieldIcon.astro';
import SparklesIcon from '../components/icons/SparklesIcon.astro';
import SearchIcon from '../components/icons/SearchIcon.astro';
import OsIcon from '../components/icons/OsIcon.astro';
import GithubIcon from '../components/icons/GithubIcon.astro';
import FomaLogo from '../components/icons/FomaLogo.astro';
import DownloadIcon from '../components/icons/DownloadIcon.astro';
import CheckIcon from '../components/icons/CheckIcon.astro';

const allProjects = (await getCollection('projects'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// Flagship featured projects
const flagshipProjects = allProjects.filter((p) => p.data.featured).slice(0, 3);

const languageColors: Record<string, string> = {
  Rust: 'bg-orange-500',
  C: 'bg-blue-500',
  C11: 'bg-blue-400',
  TypeScript: 'bg-sky-400',
  Flutter: 'bg-cyan-400',
  PHP: 'bg-indigo-400',
  'Node.js': 'bg-emerald-500',
};

const uniqueLanguages = Array.from(new Set(allProjects.map((p) => p.data.language)));
---

<Layout>
  <!-- Hero Section (Editorial Engineering Feel) -->
  <section class="relative pt-16 pb-16 md:pt-24 md:pb-24 border-b border-white/[0.07]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <!-- Tech Tagline -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-mono font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
          <span>FomaDev Systems & Tooling</span>
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white leading-[1.12]">
          High-performance software.<br class="hidden sm:inline" />
          Engineered with precision.
        </h1>

        <!-- Manifesto / Description -->
        <p class="mt-6 text-base sm:text-lg text-zinc-400 leading-relaxed font-normal max-w-2xl">
          Independent systems software built in <span class="text-zinc-200 font-medium">C</span>, <span class="text-zinc-200 font-medium">Rust</span>, and <span class="text-zinc-200 font-medium">TypeScript</span>. High-throughput databases, micro-servers, and development tools with single-binary distribution.
        </p>

        <!-- CTAs & Quick Commands -->
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-xs sm:text-sm font-semibold text-white hover:bg-blue-500 transition-all shadow-sm"
          >
            <span>Explore All Projects</span>
            <ArrowDown class="w-3.5 h-3.5" />
          </a>
          <a
            href="/license"
            class="inline-flex items-center gap-2 rounded-lg border border-white/[0.08] bg-zinc-900/80 px-4 py-2.5 text-xs sm:text-sm font-medium text-zinc-300 hover:text-white hover:border-zinc-700 hover:bg-zinc-800/80 transition-all"
          >
            <ShieldIcon class="w-3.5 h-3.5 text-blue-400" />
            <span>Licensing Guide</span>
          </a>
          <a
            href="https://github.com/fomadev"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-xs sm:text-sm font-medium text-zinc-400 hover:text-zinc-200 transition-colors"
          >
            <GithubIcon class="w-4 h-4" />
            <span>GitHub @fomadev</span>
            <ArrowUpRight class="w-3 h-3 text-zinc-500" />
          </a>
        </div>
      </div>

      <!-- Engineering Quick Specs Bar -->
      <div class="mt-14 pt-8 border-t border-white/[0.07] grid grid-cols-2 sm:grid-cols-4 gap-6 text-left">
        <div>
          <div class="text-xs font-mono text-zinc-500 uppercase tracking-wider">Architecture</div>
          <div class="text-base sm:text-lg font-semibold text-zinc-200 mt-1">Single Binary & Zero Bloat</div>
        </div>
        <div>
          <div class="text-xs font-mono text-zinc-500 uppercase tracking-wider">Source Status</div>
          <div class="text-base sm:text-lg font-semibold text-blue-400 mt-1">100% Available</div>
        </div>
        <div>
          <div class="text-xs font-mono text-zinc-500 uppercase tracking-wider">Language Stacks</div>
          <div class="text-base sm:text-lg font-semibold text-zinc-200 mt-1">C, Rust, TS, Flutter</div>
        </div>
        <div>
          <div class="text-xs font-mono text-zinc-500 uppercase tracking-wider">Business Use</div>
          <div class="text-base sm:text-lg font-semibold text-emerald-400 mt-1">Free Under FPL</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Flagship Systems Spotlight -->
  <section id="flagship" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 border-b border-white/[0.07]">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="text-xs font-mono uppercase tracking-wider text-blue-400 font-semibold">Flagship Systems</div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white mt-1">Core Implementations</h2>
      </div>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-md">
        Key standalone products developed with native performance and clear specifications.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {flagshipProjects.map((p) => {
        const isFPL = p.data.license === 'FPL';
        const langDotColor = languageColors[p.data.language] || 'bg-zinc-400';
        return (
          <div class="surface-card rounded-2xl p-6 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-300">
                  <span class={`w-2 h-2 rounded-full ${langDotColor}`}></span>
                  {p.data.language}
                </span>

                <span class="text-xs font-mono text-zinc-500">
                  {p.data.latestVersion ? `v${p.data.latestVersion}` : 'Available'}
                </span>
              </div>

              <h3 class="text-xl font-bold text-white group-hover:text-blue-400 transition-colors">
                {p.data.title}
              </h3>

              <p class="mt-2.5 text-xs sm:text-sm text-zinc-400 leading-relaxed">
                {p.data.description}
              </p>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {p.data.tags.slice(0, 3).map((t) => (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-900 text-zinc-400 border border-zinc-800">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-8 pt-4 border-t border-zinc-800/80 flex items-center justify-between">
              <span class={`text-[11px] font-mono px-2 py-0.5 rounded border ${isFPL ? 'border-emerald-500/30 text-emerald-400 bg-emerald-500/10' : 'border-amber-500/30 text-amber-400 bg-amber-500/10'}`}>
                {p.data.license}
              </span>

              <a
                href={`/projects/${p.id}/`}
                class="inline-flex items-center gap-1.5 text-xs font-medium text-blue-400 hover:text-blue-300 transition-colors"
              >
                <span>Documentation</span>
                <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Complete Projects Directory -->
  <section id="projects" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 scroll-mt-20">
    <!-- Header with Controls -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-white/[0.07]">
      <div>
        <div class="flex items-center gap-3">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">All Projects</h2>
          <span id="projects-count" class="px-2.5 py-0.5 text-xs font-mono font-medium rounded-full bg-zinc-900 text-zinc-400 border border-zinc-800">
            {allProjects.length}
          </span>
        </div>
        <p class="mt-1.5 text-xs sm:text-sm text-zinc-400">
          Filter by language, license, or query the repository directory.
        </p>
      </div>

      <!-- Search Input + View Toggle -->
      <div class="flex items-center gap-3 w-full md:w-auto">
        <div class="relative flex-1 md:w-72">
          <SearchIcon class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-500 pointer-events-none" />
          <input
            id="project-search"
            type="text"
            placeholder="Search projects..."
            class="w-full rounded-lg border border-white/[0.08] bg-zinc-900/90 pl-10 pr-4 py-2 text-xs sm:text-sm text-zinc-200 placeholder-zinc-500 focus:border-blue-500/60 focus:outline-none focus:ring-1 focus:ring-blue-500/50 transition-all"
          />
        </div>

        <!-- View Switcher (Grid vs List) -->
        <div class="hidden sm:flex items-center rounded-lg border border-white/[0.08] bg-zinc-900/90 p-1">
          <button
            type="button"
            id="view-grid-btn"
            title="Grid view"
            class="p-1.5 rounded text-zinc-400 hover:text-white transition-colors active-view bg-zinc-800 text-white"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
          </button>
          <button
            type="button"
            id="view-list-btn"
            title="List view"
            class="p-1.5 rounded text-zinc-400 hover:text-white transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Filter Pills Row -->
    <div class="mt-6 flex flex-wrap items-center gap-2" id="filter-pills">
      <span class="text-xs font-mono text-zinc-500 mr-1">Filter:</span>
      <button
        type="button"
        data-filter="all"
        class="filter-btn active rounded-md px-3 py-1.5 text-xs font-medium border border-blue-500/40 bg-blue-500/10 text-blue-400 transition-all"
      >
        All ({allProjects.length})
      </button>

      {uniqueLanguages.map((lang) => {
        const count = allProjects.filter((p) => p.data.language === lang).length;
        return (
          <button
            type="button"
            data-filter={`lang-${lang.toLowerCase()}`}
            class="filter-btn rounded-md px-3 py-1.5 text-xs font-medium border border-zinc-800 bg-zinc-900/80 text-zinc-400 hover:border-zinc-700 hover:text-zinc-200 transition-all"
          >
            {lang} <span class="text-zinc-500 font-mono text-[10px]">({count})</span>
          </button>
        );
      })}

      <div class="h-4 w-px bg-zinc-800 mx-1 hidden sm:block"></div>

      <button
        type="button"
        data-filter="license-fpl"
        class="filter-btn rounded-md px-3 py-1.5 text-xs font-medium border border-zinc-800 bg-zinc-900/80 text-zinc-400 hover:border-emerald-500/40 hover:text-emerald-400 transition-all"
      >
        FPL (Open)
      </button>
      <button
        type="button"
        data-filter="license-fcl"
        class="filter-btn rounded-md px-3 py-1.5 text-xs font-medium border border-zinc-800 bg-zinc-900/80 text-zinc-400 hover:border-amber-500/40 hover:text-amber-400 transition-all"
      >
        FCL (Commercial)
      </button>
    </div>

    <!-- Projects Grid View (Default) -->
    <ul id="projects-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {allProjects.map((p) => {
        const isFPL = p.data.license === 'FPL';
        const badgeBorder = isFPL
          ? 'border-emerald-500/30 text-emerald-400 bg-emerald-500/10'
          : 'border-amber-500/30 text-amber-400 bg-amber-500/10';
        const langDotColor = languageColors[p.data.language] || 'bg-zinc-400';
        
        const downloadOsList = Array.from(
          new Set((p.data.downloads ?? []).flatMap((d) => d.files.map((f) => f.os)))
        );

        return (
          <li
            class="project-card group"
            data-title={p.data.title.toLowerCase()}
            data-desc={p.data.description.toLowerCase()}
            data-lang={p.data.language.toLowerCase()}
            data-tags={p.data.tags.join(' ').toLowerCase()}
            data-license={p.data.license.toLowerCase()}
          >
            <a
              href={`/projects/${p.id}/`}
              class="surface-card flex flex-col h-full rounded-xl p-5 hover:border-zinc-700 transition-all"
            >
              <!-- Card Header -->
              <div class="flex items-center justify-between gap-2">
                <span class="inline-flex items-center gap-1.5 rounded bg-zinc-900 border border-zinc-800 px-2 py-0.5 text-xs font-mono text-zinc-300">
                  <span class={`w-1.5 h-1.5 rounded-full ${langDotColor}`}></span>
                  {p.data.language}
                </span>

                <div class="flex items-center gap-2">
                  {p.data.latestVersion && (
                    <span class="text-[11px] font-mono text-zinc-500">
                      v{p.data.latestVersion}
                    </span>
                  )}
                  <span class={`inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-medium border ${badgeBorder}`}>
                    {p.data.license}
                  </span>
                </div>
              </div>

              <!-- Title -->
              <h3 class="mt-3.5 text-lg font-bold text-white group-hover:text-blue-400 transition-colors">
                {p.data.title}
              </h3>

              <!-- Description -->
              <p class="mt-2 text-xs sm:text-sm text-zinc-400 leading-relaxed flex-1">
                {p.data.description}
              </p>

              <!-- Tags -->
              {p.data.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-1">
                  {p.data.tags.slice(0, 3).map((tag) => (
                    <span class="rounded bg-zinc-900 px-2 py-0.5 text-[10px] font-mono text-zinc-400 border border-zinc-800">
                      #{tag}
                    </span>
                  ))}
                  {p.data.tags.length > 3 && (
                    <span class="rounded bg-zinc-900 px-1.5 py-0.5 text-[10px] font-mono text-zinc-500 border border-zinc-800">
                      +{p.data.tags.length - 3}
                    </span>
                  )}
                </div>
              )}

              <!-- Card Footer -->
              <div class="mt-5 pt-3.5 border-t border-zinc-800/80 flex items-center justify-between text-xs">
                <div class="flex items-center gap-1 text-zinc-500">
                  {downloadOsList.length > 0 ? (
                    <div class="flex items-center gap-1.5">
                      <span class="text-[10px] font-mono text-zinc-500">Binaries:</span>
                      <div class="flex items-center gap-1 text-zinc-400">
                        {downloadOsList.map((os) => (
                          <span class="p-1 rounded bg-zinc-900 border border-zinc-800 text-zinc-400">
                            <OsIcon os={os} class="w-3 h-3" />
                          </span>
                        ))}
                      </div>
                    </div>
                  ) : (
                    <span class="text-[10px] font-mono text-zinc-500">Source code</span>
                  )}
                </div>

                <div class="inline-flex items-center gap-1 font-medium text-blue-400 group-hover:text-blue-300 transition-colors">
                  <span>View</span>
                  <ArrowRight class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
                </div>
              </div>
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Projects List / Directory View (Alternate) -->
    <div id="projects-list-table" class="hidden mt-8 overflow-x-auto rounded-xl border border-white/[0.08] bg-[#0c0e14]">
      <table class="w-full text-left text-xs sm:text-sm border-collapse">
        <thead>
          <tr class="border-b border-zinc-800 text-zinc-400 bg-zinc-900/60 font-mono text-xs">
            <th class="py-3 px-4 font-semibold">Name</th>
            <th class="py-3 px-4 font-semibold">Language</th>
            <th class="py-3 px-4 font-semibold hidden md:table-cell">Description</th>
            <th class="py-3 px-4 font-semibold">License</th>
            <th class="py-3 px-4 font-semibold hidden sm:table-cell">Release</th>
            <th class="py-3 px-4 font-semibold text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-800/60 font-sans" id="projects-table-body">
          {allProjects.map((p) => {
            const isFPL = p.data.license === 'FPL';
            const langDotColor = languageColors[p.data.language] || 'bg-zinc-400';
            return (
              <tr
                class="project-row hover:bg-white/[0.02] transition-colors"
                data-title={p.data.title.toLowerCase()}
                data-desc={p.data.description.toLowerCase()}
                data-lang={p.data.language.toLowerCase()}
                data-tags={p.data.tags.join(' ').toLowerCase()}
                data-license={p.data.license.toLowerCase()}
              >
                <td class="py-3 px-4 font-semibold text-white">
                  <a href={`/projects/${p.id}/`} class="hover:text-blue-400 transition-colors">
                    {p.data.title}
                  </a>
                </td>
                <td class="py-3 px-4">
                  <span class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-300">
                    <span class={`w-2 h-2 rounded-full ${langDotColor}`}></span>
                    {p.data.language}
                  </span>
                </td>
                <td class="py-3 px-4 text-zinc-400 max-w-sm truncate hidden md:table-cell">
                  {p.data.description}
                </td>
                <td class="py-3 px-4">
                  <span class={`text-[11px] font-mono px-2 py-0.5 rounded border ${isFPL ? 'border-emerald-500/30 text-emerald-400 bg-emerald-500/10' : 'border-amber-500/30 text-amber-400 bg-amber-500/10'}`}>
                    {p.data.license}
                  </span>
                </td>
                <td class="py-3 px-4 font-mono text-xs text-zinc-400 hidden sm:table-cell">
                  {p.data.latestVersion ? `v${p.data.latestVersion}` : '—'}
                </td>
                <td class="py-3 px-4 text-right">
                  <a
                    href={`/projects/${p.id}/`}
                    class="inline-flex items-center gap-1 text-xs font-medium text-blue-400 hover:text-blue-300"
                  >
                    <span>Inspect</span>
                    <ArrowRight class="w-3 h-3" />
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <!-- Empty Results State -->
    <div id="no-results" class="hidden mt-12 text-center py-12 rounded-xl border border-zinc-800 bg-zinc-900/40">
      <div class="inline-flex p-3 rounded-full bg-zinc-800 text-zinc-400 mb-3">
        <SearchIcon class="w-5 h-5" />
      </div>
      <h3 class="text-sm font-semibold text-zinc-200">No projects match your filter</h3>
      <p class="text-xs text-zinc-500 mt-1 max-w-xs mx-auto">
        Try clearing your search query or selecting a different language tag.
      </p>
      <button
        id="reset-filter-btn"
        type="button"
        class="mt-4 px-3 py-1.5 rounded-lg bg-blue-600 text-white text-xs font-medium hover:bg-blue-500 transition-colors"
      >
        Reset filters
      </button>
    </div>
  </section>

  <!-- Dual Licensing Policy Banner -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-20">
    <div class="rounded-2xl border border-white/[0.08] bg-[#0c0e14] p-6 sm:p-10">
      <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 pb-8 border-b border-zinc-800">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <FomaLogo class="w-4 h-4 text-blue-400" gradient={true} />
            <span class="text-xs font-mono uppercase tracking-wider text-blue-400 font-semibold">Licensing Strategy</span>
          </div>
          <h2 class="text-2xl font-bold tracking-tight text-white">
            Transparent licensing built for trust
          </h2>
          <p class="mt-2 text-xs sm:text-sm text-zinc-400 max-w-xl leading-relaxed">
            Every project created under the Fordima umbrella follows one simple rule: developers and businesses are free to use our software, while the maintainers are protected against predatory cloning.
          </p>
        </div>

        <a
          href="/license"
          class="shrink-0 inline-flex items-center gap-2 rounded-lg border border-white/[0.08] bg-zinc-900 px-4 py-2 text-xs font-medium text-zinc-300 hover:text-white hover:border-zinc-700 transition-all"
        >
          <span>Read full legal terms</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <!-- FPL Box -->
        <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/[0.02] p-5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-semibold text-emerald-400">Fordima Public License (FPL)</span>
            <span class="text-[10px] font-mono text-zinc-500">Most projects</span>
          </div>
          <h4 class="mt-2 text-base font-semibold text-white">Source-Available & Free for Business</h4>
          <p class="mt-1.5 text-xs text-zinc-400 leading-relaxed">
            Free to use in commercial products, modify, fork, and integrate into internal systems. A paid agreement is required only if you resell the code or run a competing commercial cloud service.
          </p>
          <a href="/license#fpl" class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-emerald-400 hover:text-emerald-300">
            <span>Learn about FPL</span>
            <ArrowRight class="w-3 h-3" />
          </a>
        </div>

        <!-- FCL Box -->
        <div class="rounded-xl border border-amber-500/20 bg-amber-500/[0.02] p-5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-semibold text-amber-400">Fordima Commercial License (FCL)</span>
            <span class="text-[10px] font-mono text-zinc-500">Commercial tools</span>
          </div>
          <h4 class="mt-2 text-base font-semibold text-white">Commercial Editions & Production SLAs</h4>
          <p class="mt-1.5 text-xs text-zinc-400 leading-relaxed">
            Designed for commercial desktop products like Kiva Studio. Free for local development and testing; commercial production licenses include dedicated support and fund our open-source tools.
          </p>
          <a href="/license#fcl" class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-amber-400 hover:text-amber-300">
            <span>Learn about FCL</span>
            <ArrowRight class="w-3 h-3" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side Filtering & View Toggling Script -->
  <script is:inline>
    (function () {
      const searchInput = document.getElementById('project-search');
      const filterButtons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.project-card');
      const rows = document.querySelectorAll('.project-row');
      const noResults = document.getElementById('no-results');
      const projectsCount = document.getElementById('projects-count');
      const resetBtn = document.getElementById('reset-filter-btn');

      // View switcher buttons
      const gridBtn = document.getElementById('view-grid-btn');
      const listBtn = document.getElementById('view-list-btn');
      const gridView = document.getElementById('projects-grid');
      const listView = document.getElementById('projects-list-table');

      let currentFilter = 'all';
      let currentQuery = '';

      function applyFilters() {
        let visibleCount = 0;

        function checkMatch(element) {
          const title = element.getAttribute('data-title') || '';
          const desc = element.getAttribute('data-desc') || '';
          const lang = element.getAttribute('data-lang') || '';
          const tags = element.getAttribute('data-tags') || '';
          const license = element.getAttribute('data-license') || '';

          const matchesQuery =
            !currentQuery ||
            title.includes(currentQuery) ||
            desc.includes(currentQuery) ||
            tags.includes(currentQuery) ||
            lang.includes(currentQuery);

          let matchesFilter = true;
          if (currentFilter !== 'all') {
            if (currentFilter.startsWith('lang-')) {
              const targetLang = currentFilter.replace('lang-', '');
              matchesFilter = lang.toLowerCase() === targetLang.toLowerCase();
            } else if (currentFilter === 'license-fpl') {
              matchesFilter = license.toLowerCase() === 'fpl';
            } else if (currentFilter === 'license-fcl') {
              matchesFilter = license.toLowerCase() === 'fcl';
            }
          }

          return matchesQuery && matchesFilter;
        }

        cards.forEach((card) => {
          if (checkMatch(card)) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        rows.forEach((row) => {
          if (checkMatch(row)) {
            row.classList.remove('hidden');
          } else {
            row.classList.add('hidden');
          }
        });

        if (projectsCount) {
          projectsCount.textContent = `${visibleCount}`;
        }

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = e.target.value.trim().toLowerCase();
          applyFilters();
        });

        // Keyboard shortcut: '/' to focus search
        window.addEventListener('keydown', (e) => {
          if (e.key === '/' && document.activeElement !== searchInput) {
            e.preventDefault();
            searchInput.focus();
          }
        });
      }

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterButtons.forEach((b) => {
            b.classList.remove('active', 'border-blue-500/40', 'bg-blue-500/10', 'text-blue-400');
            b.classList.add('border-zinc-800', 'bg-zinc-900/80', 'text-zinc-400');
          });
          btn.classList.add('active', 'border-blue-500/40', 'bg-blue-500/10', 'text-blue-400');
          btn.classList.remove('border-zinc-800', 'bg-zinc-900/80', 'text-zinc-400');

          currentFilter = btn.getAttribute('data-filter') || 'all';
          applyFilters();
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          currentQuery = '';
          currentFilter = 'all';
          filterButtons.forEach((b) => {
            if (b.getAttribute('data-filter') === 'all') {
              b.classList.add('active', 'border-blue-500/40', 'bg-blue-500/10', 'text-blue-400');
              b.classList.remove('border-zinc-800', 'bg-zinc-900/80', 'text-zinc-400');
            } else {
              b.classList.remove('active', 'border-blue-500/40', 'bg-blue-500/10', 'text-blue-400');
              b.classList.add('border-zinc-800', 'bg-zinc-900/80', 'text-zinc-400');
            }
          });
          applyFilters();
        });
      }

      // View toggle handling
      if (gridBtn && listBtn && gridView && listView) {
        gridBtn.addEventListener('click', () => {
          gridBtn.classList.add('bg-zinc-800', 'text-white');
          listBtn.classList.remove('bg-zinc-800', 'text-white');
          gridView.classList.remove('hidden');
          listView.classList.add('hidden');
        });

        listBtn.addEventListener('click', () => {
          listBtn.classList.add('bg-zinc-800', 'text-white');
          gridBtn.classList.remove('bg-zinc-800', 'text-white');
          listView.classList.remove('hidden');
          gridView.classList.add('hidden');
        });
      }
    })();
  </script>
</Layout>
