---
interface Props {
  class?: string;
  gradient?: boolean;
}

const {
  class: className = 'w-6 h-6',
  gradient = false,
} = Astro.props;

const strokeColor = gradient ? 'url(#foma-logo-grad)' : 'currentColor';
const fillColor = gradient ? 'url(#foma-logo-grad)' : 'currentColor';
---

<svg
  viewBox="0 0 128 128"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <defs>
    <linearGradient id="foma-logo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#60a5fa" />
      <stop offset="50%" stop-color="#3b82f6" />
      <stop offset="100%" stop-color="#1d4ed8" />
    </linearGradient>
  </defs>

  <!-- Outer Isometric Hexagon -->
  <path
    d="M64 8.5 L112 36.2 L112 91.8 L64 119.5 L16 91.8 L16 36.2 Z"
    stroke={strokeColor}
    stroke-width="8"
    stroke-linejoin="round"
    stroke-linecap="round"
  />

  <!-- Diagonal upper-right face divider -->
  <path
    d="M112 36.2 L76 57"
    stroke={strokeColor}
    stroke-width="8"
    stroke-linejoin="round"
    stroke-linecap="round"
  />

  <!-- Circuit Trace 1 (Top) -->
  <path
    d="M16 43 L36 54.5 L55 54.5"
    stroke={strokeColor}
    stroke-width="7"
    stroke-linejoin="round"
    stroke-linecap="round"
  />

  <!-- Circuit Trace 2 (Middle) -->
  <path
    d="M16 73 L70 73"
    stroke={strokeColor}
    stroke-width="7"
    stroke-linecap="round"
  />

  <!-- Circuit Trace 3 (Bottom) -->
  <path
    d="M16 94.5 L55 94.5"
    stroke={strokeColor}
    stroke-width="7"
    stroke-linecap="round"
  />

  <!-- Terminal Nodes (Donut rings with transparent hole) -->
  <path
    d="M 60 54.5 m -6.5 0 a 6.5 6.5 0 1 0 13 0 a 6.5 6.5 0 1 0 -13 0 M 60 54.5 m -2.6 0 a 2.6 2.6 0 1 1 5.2 0 a 2.6 2.6 0 1 1 -5.2 0"
    fill={fillColor}
    fill-rule="evenodd"
  />

  <path
    d="M 75 73 m -6.5 0 a 6.5 6.5 0 1 0 13 0 a 6.5 6.5 0 1 0 -13 0 M 75 73 m -2.6 0 a 2.6 2.6 0 1 1 5.2 0 a 2.6 2.6 0 1 1 -5.2 0"
    fill={fillColor}
    fill-rule="evenodd"
  />

  <path
    d="M 60 94.5 m -6.5 0 a 6.5 6.5 0 1 0 13 0 a 6.5 6.5 0 1 0 -13 0 M 60 94.5 m -2.6 0 a 2.6 2.6 0 1 1 5.2 0 a 2.6 2.6 0 1 1 -5.2 0"
    fill={fillColor}
    fill-rule="evenodd"
  />
</svg>
